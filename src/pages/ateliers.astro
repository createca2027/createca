---
import PageTexte from '../layouts/PageTexte.astro';
import { lirePage } from '../lib/markdown';
import { figureHtml } from '../lib/figure';
import TableTarifs from '../components/TableTarifs.astro';
import { tarifs, tel, site } from '../data/site';
import dessinCollectif from '../assets/photos/atelier/dessin-collectif.jpg';
const figures = {
  'images/at2.jpg': await figureHtml(dessinCollectif, { alt: 'Participants penchés sur une grande feuille au sol, dessinant ensemble', legende: 'Dessin collectif au sol', largeur: 320, incline: 1.4, ruban: true }),
};
const page = lirePage('ateliers', figures);
page.titres.push({ niveau: 2, id: 'tarifs', texte: 'Tarifs' });
---
<PageTexte page={page} titre="Les ateliers" titreSeo="Ateliers d’art-thérapie à Bordeaux"
  chapo="Cadre adapté d’expression et de communication artistiques. Chaque participant établit un protocole avec l’art-thérapeute."
  pigment="cadmium" icone="pinceau">
  <section aria-labelledby="tarifs" class="mt-16">
    <h2 id="tarifs" class="scroll-mt-24 font-titre text-titre-3">Tarifs des ateliers {tarifs.annee}</h2>
    <div class="mt-4"><TableTarifs /></div>
    <p class="mt-6">Pour les horaires de l’année en cours ou pour tout entretien individuel personnalisé : <a class="lien" href={tel(site.telephones[1].numero)}>{site.telephones[1].numero}</a>. Voir aussi l’<a href="/emploi-du-temps/" class="lien">emploi du temps</a>.</p>
  </section>
</PageTexte>
