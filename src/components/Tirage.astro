---
// Photo présentée comme un tirage posé sur la page. Les anciennes photos (200 px)
// restent à leur taille réelle : on ne les agrandit pas.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props {
  src: ImageMetadata;
  alt: string;
  legende?: string;
  largeur?: number;
  incline?: number;
  ruban?: boolean;
  class?: string;
  loading?: 'lazy' | 'eager';
  sizes?: string;
}
const { src, alt, legende, largeur, incline = -1.2, ruban = false, class: classe, loading = 'lazy', sizes } = Astro.props;
const l = Math.min(largeur ?? src.width, src.width);
---
<figure class:list={['tirage', classe]} data-ruban={ruban ? '' : undefined} style={`--incline:${incline}deg`}>
  <Image src={src} alt={alt} width={l} widths={l > 480 ? [Math.round(l / 2), l] : undefined}
    sizes={sizes ?? `(min-width: 48rem) ${l}px, 92vw`} loading={loading} decoding="async" />
  {legende && <figcaption>{legende}</figcaption>}
</figure>
