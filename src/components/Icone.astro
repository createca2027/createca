---
// Icônes dessinées à la main pour le site : outils d'atelier (trait d'encre, touche de pigment).
interface Props { nom: 'pinceau' | 'fusain' | 'modelage' | 'plume' | 'chevalet' | 'livre' | 'palette'; class?: string }
const { nom, class: classe } = Astro.props;
---
<svg viewBox="0 0 48 48" class={classe} aria-hidden="true" focusable="false" fill="none" stroke="currentColor"
  stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg">
  {nom === 'pinceau' && (
    <>
      <path d="M33.5 41.5c-3.2.4-5.6-1.6-5-4.2.5-2.3 3.3-2.6 5.4-1.7 2 .9 2.6 3.2 1.4 4.6-.4.6-1 1.1-1.8 1.3Z" fill="var(--color-cadmium)" stroke="none" opacity=".9" />
      <path d="M8.2 43.2 25.6 23.9l3.1 2.8L11 45.6c-1 .9-2.4.7-3-.3-.4-.7-.3-1.5.2-2.1Z" />
      <path d="m25.6 23.9 3.6-4 3.2 2.8-3.7 4" />
      <path d="M29.2 19.9c1.8-4.6 5.8-9.3 12.3-13.6-2.1 6.9-5.6 12.2-9.1 16.4" fill="currentColor" fill-opacity=".9" />
      <path d="M33.2 15.3c1.7-2 3.6-3.8 5.6-5.4" stroke="var(--color-papier)" stroke-width="1" />
    </>
  )}
  {nom === 'fusain' && (
    <>
      <path d="M6.5 13.5c3.3-2.6 6.2 1.9 9.6-.4 3-2 5.4 1.9 8.9.1 3.2-1.6 5.3 1.4 8.2.2" stroke="var(--color-cadmium)" stroke-width="2.4" opacity=".85" />
      <path d="M11.5 39.8 30.8 20.3l5.4 5.3-19.4 19.4c-.7.7-1.8.7-2.5 0L11.5 42.2c-.7-.6-.7-1.7 0-2.4Z" fill="currentColor" fill-opacity=".14" />
      <path d="m30.8 20.3 2.9-2.9c.9-.9 2.4-.9 3.3 0l2.1 2.1c.9.9.9 2.4 0 3.3l-2.9 2.8" />
      <path d="m15.8 37.6 3.3 3.3M20.4 33l3.3 3.3" stroke-width="1.1" />
    </>
  )}
  {nom === 'modelage' && (
    <>
      <path d="M9.3 39.7c-2.4-6.9 2.2-14.4 9.4-15.6 2.6-.4 4.3-2.3 7.1-2.7 7.5-1 13.7 5.7 12.5 13.4-.6 3.6-3.3 6.8-7.8 7.5-6.9 1-12.5.9-17.3-.3-1.8-.5-3.3-1.1-3.9-2.3Z" fill="var(--color-ocre)" fill-opacity=".55" />
      <path d="M17.6 35.6c1.8-3.4 6.1-3.9 8.6-1.1M15.2 38.8c2.9-5.6 10-6.4 14.2-1.7" />
      <path d="m31.2 7.1 6.9 11.7" />
      <ellipse cx="39.4" cy="21.3" rx="2.6" ry="3.6" transform="rotate(-30 39.4 21.3)" />
    </>
  )}
  {nom === 'plume' && (
    <>
      <path d="M8 43.5c4.9-1.7 8.9 1.6 13.8-.1 4.6-1.6 8.3 1.4 12.6-.2" stroke="var(--color-cadmium)" stroke-width="2.2" opacity=".85" />
      <path d="M24 5.5c5.6 5.3 8.4 12 7.8 19.2L24 37.8l-7.8-13.1c-.6-7.2 2.2-13.9 7.8-19.2Z" fill="currentColor" fill-opacity=".12" />
      <path d="M24 37.8V25.6" />
      <circle cx="24" cy="22.6" r="2.1" />
    </>
  )}
  {nom === 'chevalet' && (
    <>
      <path d="M24 5.5 13.3 44M24 5.5 34.7 44M24 31v13" />
      <rect x="11.5" y="11.8" width="25" height="18.6" rx="1" fill="var(--color-papier)" />
      <path d="M15.2 26.1c2.6-4.4 5.4-1.9 7.6-5.2 1.9-2.8 5-1.4 6.4-3.6 1-1.5 2.5-1.6 3.5-.8" stroke="var(--color-cadmium)" stroke-width="2.1" opacity=".9" />
      <path d="M9.8 30.4h28.4" />
    </>
  )}
  {nom === 'livre' && (
    <>
      <path d="M24 14.6c-4.6-3.4-10.8-4.4-17.2-2.9v26.2c6.4-1.5 12.6-.5 17.2 2.9 4.6-3.4 10.8-4.4 17.2-2.9V11.7c-6.4-1.5-12.6-.5-17.2 2.9Z" fill="var(--color-lavis)" />
      <path d="M24 14.6v26.2" />
      <path d="M11 19.3c3.1-.4 6.2.2 8.9 1.7M11 24.7c3.1-.4 6.2.2 8.9 1.7M28.1 21c2.7-1.5 5.8-2.1 8.9-1.7" stroke-width="1.2" />
      <path d="M28.1 26.4c2.6-1.5 5.4-1.6 7.6-1.2" stroke="var(--color-cadmium)" stroke-width="2" opacity=".9" />
    </>
  )}
  {nom === 'palette' && (
    <>
      <path d="M24.4 6.6C13.3 6.4 5.6 14 6 24.2c.3 8.9 7.6 16.6 17 17.1 4.6.3 6.1-2.3 4.6-5-1.3-2.4.3-4.8 3.2-4.6 3.1.2 5.5.6 7.8-.9 3.3-2.1 4.1-6.5 2.8-10.4-2.4-7.2-9.1-13.7-17-13.8Z" fill="var(--color-papier)" />
      <circle cx="15.2" cy="18.6" r="2.8" fill="var(--color-cadmium)" stroke="none" />
      <circle cx="23.6" cy="14" r="2.8" fill="var(--color-ocre)" stroke="none" />
      <circle cx="32" cy="17.4" r="2.8" fill="var(--color-cobalt)" stroke="none" />
      <circle cx="14" cy="28.4" r="2.8" fill="currentColor" stroke="none" />
    </>
  )}
</svg>
