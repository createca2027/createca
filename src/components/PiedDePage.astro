---
import { plan, site, tel, carteUrl } from '../data/site';
import Embleme from './Embleme.astro';
---
<footer class="sur-encre mt-24 bg-encre text-papier">
  <div class="page grid gap-12 py-16 lg:grid-cols-12">
    <div class="lg:col-span-4">
      <Embleme nom="embleme-rayonnant" teinte="papier" class="h-auto w-44 opacity-90" />
      <p class="mt-6 font-titre text-[1.35rem] font-semibold leading-snug">{site.devise}</p>
      <p class="mt-3 max-w-xs text-[1rem] leading-relaxed text-papier/80">{site.nomLong}, depuis {site.depuis}.</p>
    </div>
    <div class="lg:col-span-3">
      <h2 class="font-titre text-[1.35rem] text-papier">Venir à Createca</h2>
      <address class="mt-3 not-italic leading-relaxed text-papier/90">
        {site.adresse.rue}<br />{site.adresse.cp} {site.adresse.ville}-{site.adresse.quartier}
      </address>
      <a class="mt-2 inline-block text-papier underline decoration-papier/50 underline-offset-4 hover:decoration-ocre" href={carteUrl} rel="noopener">Voir sur la carte</a>
      <ul class="mt-5 space-y-1.5">
        {site.telephones.map((t) => (
          <li><span class="text-papier/75">{t.libelle} : </span><a href={tel(t.numero)} class="text-papier underline decoration-papier/40 underline-offset-4 hover:decoration-ocre">{t.numero}</a></li>
        ))}
        <li><a href={`mailto:${site.email}`} class="text-papier underline decoration-papier/40 underline-offset-4 hover:decoration-ocre">{site.email}</a></li>
      </ul>
      <p class="mt-5 flex flex-wrap gap-x-5 gap-y-2">
        <a href={site.facebook} rel="noopener" class="text-papier underline decoration-papier/40 underline-offset-4 hover:decoration-ocre">Createca sur Facebook</a>
        <a href={site.plaquette} class="text-papier underline decoration-papier/40 underline-offset-4 hover:decoration-ocre">Plaquette (PDF)</a>
      </p>
    </div>
    <nav aria-label="Plan du site" class="grid grid-cols-2 gap-x-8 gap-y-8 sm:grid-cols-4 lg:col-span-5 lg:grid-cols-2">
      {plan.map((groupe) => (
        <ul class="space-y-2">
          {groupe.map((item) => (
            <li><a href={item.href} class="font-titre text-[1.15rem] font-semibold text-papier no-underline hover:underline hover:decoration-ocre hover:underline-offset-4">{item.titre}</a></li>
          ))}
        </ul>
      ))}
    </nav>
  </div>
  <div class="border-t border-papier/15">
    <div class="page flex flex-col gap-2 py-6 text-[0.875rem] text-papier/70 md:flex-row md:flex-wrap md:justify-between">
      <p>Organisme de formation certifié Qualiopi, n° {site.qualiopi.numero}. N° de déclaration d’activité : {site.legal.activite}.</p>
      <p>SIRET {site.legal.siret}, code NAF {site.legal.naf}.</p>
      <p>Site créé par <a href="https://waimia.com" class="text-papier underline decoration-papier/40 underline-offset-4 hover:decoration-ocre">Waimia</a>.</p>
    </div>
  </div>
</footer>
